# Django Environment Configuration
SECRET_KEY=django-insecure-agrisense-secret-key-change-in-production!
DEBUG=True
ALLOWED_HOSTS=*

# Database Configuration Options
# Option 1: SQLite (Default local file database)
DB_ENGINE=sqlite
DATABASE_URL=sqlite:///db.sqlite3

# Option 2: PostgreSQL (Set DB_ENGINE=postgres or provide DATABASE_URL)
# DB_ENGINE=postgres
# POSTGRES_DB=agrisense_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/agrisense_db

# Redis & Celery Configuration
REDIS_URL=redis://127.0.0.1:6379/0
